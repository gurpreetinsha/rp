# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Student Result Portal"
API_V1_PREFIX=/api/v1

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/srp_db

# Security & Authentication
# Generate a secure 32+ character random secret in production
SECRET_KEY=change_me_to_a_secure_random_secret_key_32_characters_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
